# Copy this to  .env  (in the same folder as docker-compose.yml) and fill it in.
# docker compose reads this file automatically.

# Database (a fresh MySQL container is created with these)
DB_NAME=hms_db
DB_PASSWORD=change_this_db_password

# Auth — use two different long random strings
JWT_ACCESS_SECRET=change_this_access_secret_to_something_long_and_random
JWT_REFRESH_SECRET=change_this_refresh_secret_to_something_long_and_random

# Not critical behind the nginx proxy (same-origin), but set it anyway
CLIENT_URL=http://localhost

# Optional email — leave blank to log reset/verification links to the console
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@dhulikhel-hms.local
